# Base URL of the PHP API backend (DDEV default shown).
# Copy to .env and adjust for your environment.
# Port 5174 is this project's dedicated router_https_port (see
# backend/.ddev/config.yaml), set to avoid clashing with port 5173 which
# another local DDEV project's Vite proxy add-on may reserve router-wide.
VITE_API_URL=https://pmpquiz-api.ddev.site:5174
